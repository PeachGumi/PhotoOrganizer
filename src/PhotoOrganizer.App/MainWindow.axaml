<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PhotoOrganizer.App"
        x:Class="PhotoOrganizer.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Photo Organizer"
        Icon="/Assets/photo-organizer-icon.ico"
        Width="920"
        Height="780"
        MinWidth="760"
        MinHeight="620">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24" Spacing="16">
      <StackPanel Spacing="4">
        <TextBlock Text="Photo Organizer" FontSize="28" FontWeight="SemiBold" />
        <TextBlock Text="SDカードの写真・動画を、安全を確認しながら整理して取り込みます"
                   Opacity="0.7" TextWrapping="Wrap" />
      </StackPanel>

      <Border Padding="16" CornerRadius="10" BorderThickness="1">
        <StackPanel Spacing="5">
          <TextBlock Text="次に行うこと" FontSize="12" Opacity="0.6" />
          <TextBlock Text="{Binding WorkflowHeadline}"
                     FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding WorkflowDetail}"
                     Opacity="0.75" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Padding="16" CornerRadius="10" BorderThickness="1">
        <StackPanel Spacing="14">
          <TextBlock Text="取り込み" FontSize="18" FontWeight="SemiBold" />

          <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="110,*,Auto" RowSpacing="12" ColumnSpacing="10">
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="SDカード" VerticalAlignment="Center" />
            <Border Grid.Row="0" Grid.Column="1"
                    Padding="10,7" CornerRadius="6" BorderThickness="1">
              <TextBlock Text="{Binding SelectedSdDisplay}"
                         TextWrapping="Wrap" />
            </Border>
            <Button Grid.Row="0" Grid.Column="2"
                    Content="SDカードを選択…"
                    Click="SelectSd_Click"
                    IsEnabled="{Binding !IsBusy}" />

            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                        Orientation="Horizontal" Spacing="14">
              <TextBlock Text="{Binding CountLabel}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding PendingSdText}" Opacity="0.65" />
              <TextBlock Text="対象: JPG/JPEG・設定済みRAW・MOV/MP4" Opacity="0.55" />
            </StackPanel>

            <TextBlock Grid.Row="2" Grid.Column="0"
                       Text="保存先" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1"
                     Text="{Binding DestinationPath, Mode=TwoWay}"
                     IsEnabled="{Binding !IsBusy}"
                     PlaceholderText="写真ライブラリの保存先" />
            <Button Grid.Row="2" Grid.Column="2"
                    Content="選択…"
                    Click="SelectDestination_Click"
                    IsEnabled="{Binding !IsBusy}" />

            <TextBlock Grid.Row="3" Grid.Column="0"
                       Text="イベント名" VerticalAlignment="Center" />
            <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                     Text="{Binding EventName, Mode=TwoWay}"
                     IsEnabled="{Binding !IsBusy}"
                     PlaceholderText="例: 旅行、運動会、撮影会" />
          </Grid>

          <Border Padding="12" CornerRadius="8" BorderThickness="1">
            <StackPanel Spacing="4">
              <TextBlock Text="保存先プレビュー" FontSize="12" Opacity="0.6" />
              <TextBlock x:Name="DestinationPreviewText"
                         TextWrapping="Wrap"
                         FontFamily="monospace" />
              <TextBlock Text="日付は今回の新規対象メディアの最古撮影日から自動で決まります。"
                         FontSize="12" Opacity="0.55" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
            <Button Grid.Column="0"
                    Classes="accent"
                    Content="取り込みを開始"
                    Click="Import_Click"
                    IsEnabled="{Binding CanImport}"
                    MinWidth="150" />
            <Button Grid.Column="1"
                    Content="キャンセル"
                    Click="Cancel_Click"
                    IsEnabled="{Binding CanCancel}" />
            <TextBlock Grid.Column="2"
                       Text="{Binding ProgressLabel}"
                       VerticalAlignment="Center"
                       Opacity="0.7" />
          </Grid>
        </StackPanel>
      </Border>

      <Border IsVisible="{Binding ShowSafetyPanel}"
              Padding="16" CornerRadius="10" BorderThickness="2"
              BorderBrush="{Binding SafetyBrush}">
        <StackPanel Spacing="6">
          <TextBlock Text="SDカードの再利用" FontSize="13" Opacity="0.65" />
          <TextBlock Text="{Binding SafetyHeadline}"
                     FontSize="18" FontWeight="SemiBold"
                     Foreground="{Binding SafetyBrush}"
                     TextWrapping="Wrap" />
          <TextBlock Text="{Binding SafetyDetail}" TextWrapping="Wrap" />
          <TextBlock Text="再利用可能の表示は、指定した保存先1か所への実ファイル照合と永続化を確認したことを示します。別媒体への二重バックアップ済みという意味ではありません。"
                     FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Expander Header="詳細設定">
        <Border Margin="0,8,0,0" Padding="16" CornerRadius="10" BorderThickness="1">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto" RowSpacing="4">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="RAW拡張子" VerticalAlignment="Center" />
              <TextBox Grid.Row="0" Grid.Column="1"
                       Text="{Binding RawExtensionsText, Mode=TwoWay}"
                       IsEnabled="{Binding !IsBusy}"
                       PlaceholderText=".arw, .cr3, .nef, ..." />
              <TextBlock Grid.Row="1" Grid.Column="1"
                         Text="JPG/JPEGとMOV/MP4は常に対象です。ここには追加で取り込みたいRAW拡張子を指定します。"
                         FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
            </Grid>

            <StackPanel Spacing="4">
              <CheckBox Content="ログイン時にPhoto Organizerを自動起動"
                        IsChecked="{Binding AutoStart, Mode=TwoWay}"
                        IsEnabled="{Binding AutoStartSupported}" />
              <TextBlock Text="SDカードの再利用可否は、安全のためアプリ再起動後には引き継ぎません。"
                         Margin="24,0,0,0" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="4">
              <CheckBox x:Name="StartInBackgroundCheckBox"
                        Content="起動時はトレイ / メニューバーに常駐" />
              <TextBlock x:Name="BackgroundSettingStatus"
                         Margin="24,0,0,0"
                         FontSize="12"
                         TextWrapping="Wrap"
                         Opacity="0.6" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Expander>

      <Expander Header="詳細ログ">
        <TextBox Margin="0,8,0,0"
                 Height="220"
                 Text="{Binding LogText}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 FontFamily="monospace" />
      </Expander>
    </StackPanel>
  </ScrollViewer>
</Window>
